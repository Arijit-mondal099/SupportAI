NEXT_PUBLIC_API_URI=http://localhost:3000

# Scalekit
SCALEKIT_ENVIRONMENT_URL=https://your-org.scalekit.dev
SCALEKIT_CLIENT_ID=skc_xxxxxxxxxxxxxxxx
SCALEKIT_CLIENT_SECRET=your_scalekit_client_secret

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/db_name

# Pinecone (knowledge base / RAG). Create a 768-dimension, cosine index.
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_pinecone_index_name

# Upstash Redis (optional — enables response caching + rate limiting).
# If left unset, the app falls back to direct MongoDB calls with no rate limits.
UPSTASH_REDIS_REST_URL=https://your-redis-upstash-io.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_redis_token
